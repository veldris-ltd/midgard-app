<!-- Everything testable without a window: paths, ports, the system check, the working
     copy. No UI. The few Windows-only APIs (the ACL reader, the instance lock) are in
     classes marked [SupportedOSPlatform("windows")], so the rest and its tests run on any
     OS; the window app (Midgard) supplies the other Windows-only facts. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Midgard.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Midgard.Core.Tests" />
  </ItemGroup>
</Project>
