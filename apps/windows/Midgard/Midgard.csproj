<!-- Midgard.exe: the WinForms window, published self-contained for win-x64 as one file
     by the windows-shell-build job (tools/ci/run.sh). The runtime identifier is fixed
     here so that the locked restore of the solution already holds the win-x64 runtime
     packs publish needs, and the lock file has one shape. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Midgard</AssemblyName>
    <RootNamespace>Midgard</RootNamespace>
    <!-- LibraryImport (WindowsFacts) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WebView2Loader.dll goes inside the single-file Midgard.exe too (extracted at run time). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No referenced assemblies' .xml docs beside Midgard.exe (WebView2 ships three). -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <!-- The window's web view (BSD-style licence, LICENSE.txt in the package; W4 copies it to
         resources\licenses). Pinned; its hash is in packages.lock.json. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Midgard.Core\Midgard.Core.csproj" />
  </ItemGroup>
  <!-- WebView2's targets reference its WPF control too, which pulls in WPF's WindowsBase
       (MSB3277 against the one WinForms has). The window is WinForms only. -->
  <Target Name="MidgardDropWebView2Wpf" AfterTargets="ResolveLockFileReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
