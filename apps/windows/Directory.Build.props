<!-- Shared settings for the Windows shell (docs/plans/2026-10-23-windows-app-w2-shell.md).
     Every project restores from a committed packages.lock.json; CI restores with
     locked mode, so a package can change only by a commit that changes the lock file. -->
<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Company>Veldris Ltd</Company>
    <Product>Midgard</Product>
  </PropertyGroup>
</Project>
