{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midgard.dev/contracts/schema/ontology.v1.schema.json",
  "title": "Midgard ontology file, version 1",
  "description": "The object types, link types and actions an enclosure serves. The gateway reads this file at every start and refuses to start if it is invalid. This schema states the shape of the file. Four rules are checked by the gateway and cannot be stated here: ids are unique within their kind, as are property names within a type and action names; both ends of a link type name a declared object type; an action names a declared object type; and an effect names a text property that the action's object type declares.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "objectTypes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "objectTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectType"
      }
    },
    "linkTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkType"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "description": "Letters, digits, underscore and hyphen.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "text": {
      "description": "A string with at least one character that is not white space.",
      "type": "string",
      "pattern": "\\S"
    },
    "band": {
      "enum": [
        "open",
        "internal",
        "restricted",
        "confidential"
      ]
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "text",
            "int",
            "float",
            "bool",
            "timestamp"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "linkType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "from",
        "to",
        "cardinality"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-many"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "title",
        "objectType",
        "marking",
        "purposes",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "objectType": {
          "$ref": "#/$defs/identifier"
        },
        "humanGated": {
          "type": "boolean",
          "default": true
        },
        "marking": {
          "$ref": "#/$defs/band"
        },
        "compartments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "effect": {
          "oneOf": [
            {
              "$ref": "#/$defs/setProperty"
            },
            {
              "$ref": "#/$defs/cycleProperty"
            }
          ]
        }
      }
    },
    "setProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "property",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "set-property"
        },
        "property": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "cycleProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "property",
        "values"
      ],
      "properties": {
        "kind": {
          "const": "cycle-property"
        },
        "property": {
          "$ref": "#/$defs/identifier"
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
