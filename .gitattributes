# Auto detect text files and perform LF normalization
* text=auto

# Vendored crates are checksummed by cargo (each crate's .cargo-checksum.json is a
# sha256 over its files). Git MUST NOT convert their line endings on checkout, or
# the checksums fail and the offline/air-gap build breaks. Store and check out
# byte-for-byte. [NFR-PRV-1] [NFR-OSS-1]
vendor/** -text

# Generated lockfile — keep LF for stable, platform-independent diffs.
Cargo.lock text eol=lf

# Shell scripts run inside Linux containers; a CRLF checkout would break them.
*.sh text eol=lf

# A gate record cites the SHA-256 of the logs beside it, and is itself compared
# byte for byte with what those logs give. Store and check out exactly.
# [AC-RF-CA-5b]
docs/compliance/gate-runs/** -text

# The numbers sheet is compared byte for byte with what tools/ci/numbers.sh prints.
# [AC-RF-CA-2a]
docs/compliance/NUMBERS.md text eol=lf

# Read by git and ssh-keygen to verify release tags. [AC-RF-CA-6a]
deploy/trust/allowed_signers text eol=lf
