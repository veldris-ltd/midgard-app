<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Ad-hoc builds (no MIDGARD_TEAM_ID; Config/Signing.xcconfig): MidgardMac.entitlements
     without keychain-access-groups, a restricted entitlement that stops an ad-hoc app
     from launching. Such a build cannot keep keys outside UI testing. [DD-6] [FR-C-9] -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
