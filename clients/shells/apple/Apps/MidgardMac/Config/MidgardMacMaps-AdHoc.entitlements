<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Midgard (the Maps edition), ad-hoc builds (no MIDGARD_TEAM_ID): MidgardMacMaps.entitlements
     without keychain-access-groups. The client network entitlement is for Phase I's map
     tiles and Phase J's user-added hosts; read access to the files the user picks. [DD-6] [FR-C-9] -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
