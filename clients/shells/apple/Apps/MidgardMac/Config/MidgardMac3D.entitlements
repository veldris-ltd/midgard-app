<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Midgard 3D, team-signed builds (MIDGARD_TEAM_ID set; Config/Signing.xcconfig, chosen by
     project.yml's MidgardMac3D settings). App Sandbox with no network entitlement, as the
     release app: only the maps edition has one (tools/check-edition.sh). Its own keychain
     access group, for its own bundle identifier. [DD-6] [FR-C-9] -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.veldris.midgard3d.mac</string>
	</array>
</dict>
</plist>
