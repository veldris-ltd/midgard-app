    while :; do
        step 6 "DATA AND FEEDS"
        printf '  %s%sHEIMDALL FEEDS%s  %stype a number to add or remove a family, then Enter%s\n\n' \
            "$C_HEIMDALL" "$B" "$R" "$C_MUTED" "$R"
        local i=1 fam mark have total names
        for fam in "${FEED_FAMILIES[@]}"; do
            read -r _ have total names < <(grep "^$fam " <<<"$table")
            if [[ " $FEEDS " == *" $fam "* ]]; then mark="${C_SECURE}[x]${R}"; else mark="${C_FAINT}[ ]${R}"; fi
            printf '  %s%d%s  %s %s%-15s%s %s%d of %d feed%s%s  %s\n' "$C_MUTED" "$i" "$R" "$mark" "$B" "$fam" "$R" \
                "$C_MUTED" "$have" "$total" "$([ "$total" = 1 ] || echo s)" "$R" "${names//,/, }"
            i=$((i + 1))
        done
        echo
        printf '  %sToggle 1-%d, or Enter to continue:%s ' "$C_BODY" "${#FEED_FAMILIES[@]}" "$R"
        read -r REPLY
        [ -z "$REPLY" ] && break
