# ---- the install -----------------------------------------------------------------------

# A fresh copy each time, swapped in whole, so an upgrade leaves no stale files behind.
copy_source() {
    if [ -d "$SRC" ] && [ "$(readlink -f "$REPO")" = "$(readlink -f "$SRC")" ]; then
        echo "running from the installed source; nothing to copy"
        return 0
    fi
    rm -rf "$SRC.new" "$SRC.old"
    mkdir -p "$SRC.new"
    tar -C "$REPO" --exclude=./.git --exclude=./target --exclude=node_modules \
        -cf - . | tar -C "$SRC.new" -xf -
    [ -d "$SRC" ] && mv "$SRC" "$SRC.old"
    mv "$SRC.new" "$SRC"
    rm -rf "$SRC.old"
}

# Where the sample datasets come from: the repository's open set, or the full set
# extracted from the zip the operator named.
samples_dir() {
    if [ -n "$SAMPLES_ZIP" ]; then
        dirname "$(find "$INSTALL_DIR/samples-full" -type d -name 1-configuration -not -path '*__MACOSX*' | head -1)"
    else
        echo "$SRC/samples"
    fi
}

extract_samples() {
    rm -rf "$INSTALL_DIR/samples-full"
    python3 -I - "$SAMPLES_ZIP" "$INSTALL_DIR/samples-full" <<'EOF'
import os, sys, zipfile
archive, out = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(archive) as z:
    for name in z.namelist():
        if "__MACOSX" in name or name.endswith("/"):
            continue
        target = os.path.realpath(os.path.join(out, name))
        if not target.startswith(os.path.realpath(out) + os.sep):
            raise SystemExit(f"refusing {name}: it would land outside {out}")
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with z.open(name) as src, open(target, "wb") as dst:
            dst.write(src.read())
EOF
    chmod -R a+rX "$INSTALL_DIR/samples-full"
    [ -d "$(samples_dir)" ] || { echo "the zip holds no 1-configuration folder"; return 1; }
    echo "extracted to $(samples_dir)"
}

convert() { python3 -I "$SRC/samples/convert.py" "$@"; }

feed_list() { has heimdall && [ -n "$FEEDS" ] && convert feeds --samples "$(samples_dir)" --families "$FEEDS"; true; }

build_toolchain() {
    if docker image inspect "$TOOLCHAIN_IMAGE" >/dev/null 2>&1; then
        echo "the toolchain image is already built"
    else
        docker build -t "$TOOLCHAIN_IMAGE" "$SRC/deploy/acceptance"
    fi
}

write_site() {
    # shellcheck disable=SC1090
    . "$HERE/profiles/$PROFILE/profile.env"
    local prof="$SRC/deploy/installer/profiles/$PROFILE"
    mkdir -p "$SITE"
    chmod 0755 "$SITE"
    {
        echo "# Written by mg-install for this server. Regenerated on every run: edit the"
        echo "# installer's profile instead. [RC-33] [NFR-SEC-1]"
        echo "services:"
        # The profile's schema and policy, joined with the sample configuration's when the
        # profile loads recorded datasets; Forge's jobs are joined the same way.
        local samples
        samples="$(samples_dir)"
        rm -rf "$SITE/forge" "$SITE/.samples-forge"
        mkdir -p "$SITE/forge"
        install -m 0644 "$prof"/forge/*.csv "$SITE/forge/"
        if [ -n "$PROFILE_SAMPLES" ]; then
            convert ontology --samples "$samples" >"$SITE/.samples-ontology.json" 2>>"$LOG"
            convert merge "$SITE/.samples-ontology.json" "$prof/ontology.json" >"$SITE/ontology.json"
            convert merge "$samples/1-configuration/midgard/policy.json" "$prof/policy.json" >"$SITE/policy.json"
            convert forge --samples "$samples" --datasets "$PROFILE_SAMPLES" --out "$SITE/.samples-forge" 2>>"$LOG"
            install -m 0644 "$SITE"/.samples-forge/*.csv "$SITE/forge/"
            convert merge "$SITE/.samples-forge/jobs.json" "$prof/forge/jobs.json" >"$SITE/forge/jobs.json"
            rm -rf "$SITE/.samples-forge" "$SITE/.samples-ontology.json"
        else
            install -m 0644 "$prof/ontology.json" "$prof/policy.json" "$SITE/"
            install -m 0644 "$prof/forge/jobs.json" "$SITE/forge/jobs.json"
        fi
        chmod 0644 "$SITE/ontology.json" "$SITE/policy.json" "$SITE"/forge/*
        chmod 0755 "$SITE/forge"
        echo "  init:"
        echo "    volumes:"
        echo "      - $SITE/ontology.json:/etc/midgard/core-ontology.json:ro"
        echo "      - $SITE/policy.json:/etc/midgard/core-policy.json:ro"
        echo "  gateway:"
        echo "    entrypoint: [http-gateway, --state-dir, /state, --bind, \"0.0.0.0:7710\","
        echo "                 --mesh-bind, \"0.0.0.0:7711\", --mesh-identity-dir, /mesh-identity,"
        echo "                 --allow-origin, \"http://localhost:5173\", --allow-origin, \"http://127.0.0.1:5173\"]"
        if has forge; then
            echo "  forge-worker:"
            echo "    volumes:"
            echo "      - $SITE/forge:/etc/midgard/forge:ro"
        fi
        if [ "$CONSOLE" = yes ]; then
            cat <<EOF
  console:
    image: $CONSOLE_IMAGE
    pull_policy: never
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp", "/var/cache/nginx"]
    environment:
      NGINX_ENTRYPOINT_QUIET_LOGS: "1"
    networks: [edge]
    ports:
      - "127.0.0.1:5173:8080"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:8080/"]
      interval: 10s
      timeout: 3s
      retries: 6
EOF
        fi
    } >"$SITE/compose.site.yaml"
    dc config --quiet
}

enrolled() { dc run --rm --no-deps -T --entrypoint mg-admin init user list --state-dir /vol/core-state 2>/dev/null | grep -qw -- "$1"; }

enrol_operator() {
    # shellcheck disable=SC1090
    . "$HERE/profiles/$PROFILE/profile.env"
    local out flags=() password
    if enrolled "$OPERATOR"; then ok "$OPERATOR is already enrolled."; return 0; fi
    if [ "$UNATTENDED" = 1 ]; then
        [ -r "${ANSWER[OPERATOR_PASSWORD_FILE]:-}" ] || die "OPERATOR_PASSWORD_FILE is not a readable file"
        password="$(head -n 1 "${ANSWER[OPERATOR_PASSWORD_FILE]}")"
        [ "${#password}" -ge 12 ] || die "the operator's password must have at least 12 characters"
    else
        echo
        say "Choose $OPERATOR's password now (at least 12 characters). It is not shown or stored."
        secret "Password for $OPERATOR:"
        password="$REPLY"
    fi
    [ "$OPERATOR_TOTP" = yes ] && flags+=(--totp)
    # The output can carry the TOTP secret, so it goes to the screen only, never the log.
    if ! out="$(printf '%s\n' "$password" | dc run --rm --no-deps -T --entrypoint mg-admin init \
        user add --state-dir /vol/core-state --subject "$OPERATOR" --roles operator \
        --clearance "$PROFILE_CLEARANCE" --purposes "$PROFILE_PURPOSES" "${flags[@]}" 2>&1)"; then
        unset password
        bad "Enrolling $OPERATOR failed:"
        grep -v 'otpauth://' <<<"$out" | sed 's/^/      /'
        exit 1
    fi
    # Kept in memory until the sign-in check at the end of the install, then dropped.
    LOGIN_CHECK_PASSWORD="$password"
    unset password
    echo "enrolled $OPERATOR" >>"$LOG"
    ok "Enrolled $OPERATOR."
    local uri
    uri="$(grep -o 'otpauth://[^[:space:]]*' <<<"$out" | head -1 || true)"
    LOGIN_CHECK_TOTP_KEY="$(sed -n 's/.*[?&]secret=\([A-Z2-7]*\).*/\1/p' <<<"$uri")"
    if [ -n "$uri" ]; then
        echo
        printf '  %s%sSET UP THE AUTHENTICATOR APP NOW%s\n' "$C_WARN" "$B" "$R"
        say "This is shown once and is not saved anywhere. Scan it with an authenticator app"
        say "(for example Microsoft Authenticator, Google Authenticator or KeePassXC)."
        echo
        if command -v qrencode >/dev/null 2>&1 && [ "$INTERACTIVE_TERM" = 1 ]; then
            qrencode -t ANSIUTF8 -m 2 "$uri" | sed 's/^/    /'
        fi
        local key
        key="$(sed -n 's/.*[?&]secret=\([A-Z2-7]*\).*/\1/p' <<<"$uri")"
        label "Account"; echo "$OPERATOR"
        label "Key (type it in)"; printf '%s%s%s\n' "$B" "$(sed 's/.\{4\}/& /g' <<<"$key")" "$R"
        [ "$INTERACTIVE_TERM" = 1 ] || { label "URI"; echo "$uri"; }
        command -v qrencode >/dev/null 2>&1 || note "  Install qrencode to see a QR code here instead of typing the key."
        if [ "$UNATTENDED" = 0 ]; then
            echo
            printf '  %sPress Enter once the app shows a 6-digit code for Midgard.%s ' "$C_BODY" "$R"
            read -r _
            step 9 "INSTALLING"
            ok "Enrolled $OPERATOR. The authenticator key has been cleared from the screen."
        fi
    fi
}

enrol_admins() {
    [ -n "$ADMIN_1" ] || return 0
    local keys="$INSTALL_DIR/admin-passkeys" a
    install -d -m 0700 "$keys"
    for a in "$ADMIN_1" "$ADMIN_2"; do
        if [ -f "$keys/$a.passkey" ] || [ -f "$keys/.$a.handed-over" ]; then
            ok "Administrator $a already exists."
            continue
        fi
        chown 10001:10001 "$keys"
        dc run --rm --no-deps -T -v "$keys:/admin-passkeys" --entrypoint mg-admin init \
            admin add --state-dir /vol/core-state --admin "$a" --role IAM-Admin \
            --keystore "/admin-passkeys/$a.passkey" >>"$LOG" 2>&1 ||
            { chown root:root "$keys"; die "Creating administrator $a failed. See $LOG."; }
        chown root:root "$keys" "$keys/$a.passkey"
        chmod 0600 "$keys/$a.passkey"
        ok "Administrator $a created. Passkey: $keys/$a.passkey"
    done
}

stage_model() {
    local file="${ANSWER[MODEL_FILE]:-}" dl="$INSTALL_DIR/downloads"
    # Staged means a format 2 manifest: one signed over its own bytes, which
    # mimir-server checks before parsing it. An older manifest is signed again. [MG-SEC-14]
    if docker run --rm -v midgard-models:/models "$DEV_IMAGE" sh -c \
        'head -n 1 /models/granite/model.manifest 2>/dev/null | grep -qx "midgard-model-manifest 2"' 2>/dev/null; then
        echo "the model is already staged"
        return 0
    fi
    if docker run --rm -v midgard-models:/models "$DEV_IMAGE" test -f "/models/granite/$GRANITE_GGUF" 2>/dev/null; then
        echo "the model's manifest predates format 2; signing it again"
        bash "$SRC/deploy/compose/stage-model.sh"
        return 0
    fi
    if [ -z "$file" ]; then
        mkdir -p "$dl"
        file="$dl/$GRANITE_GGUF"
        if [ ! -f "$file" ]; then
            curl -fL --retry 3 --retry-delay 5 -o "$file.part" "$GRANITE_URL"
            mv "$file.part" "$file"
        fi
    fi
    bash "$SRC/deploy/compose/stage-model.sh" "$file"
    [ "$file" = "$dl/$GRANITE_GGUF" ] && rm -f "$file"
    return 0
}

# One certified mesh identity per feed: the feed id Heimdall checks is the service its
# certificate names. Needs the enclosure's lock, so it runs while the gateway is stopped.
issue_feed_identities() {
    local feeds
    feeds="$(feed_list)"
    [ -n "$feeds" ] || { echo "no feeds chosen"; return 0; }
    # shellcheck disable=SC2016,SC2086
    dc run --rm --no-deps -T --entrypoint sh init -c '
        for feed in "$@"; do
            if [ -f "/vol/heimdall-clients/$feed.cert" ]; then
                echo "$feed already has an identity"
            else
                mg-admin mesh issue --state-dir /vol/core-state --service "$feed" \
                    --roles feed-source --out /vol/heimdall-clients
            fi
        done' sh $feeds
}

# Replay the chosen feeds' observations into Heimdall, each signed by its feed's own
# identity, then check the picture holds them.
replay_feeds() {
    local feeds dir="$SITE/feeds" digest
    feeds="$(feed_list)"
    [ -n "$feeds" ] || { echo "no feeds chosen"; return 0; }
    install -d -m 0755 "$dir"
    # Heimdall returns the whole picture in one PQ-mTLS frame of at most 1 MiB
    # (crypto/pq-mtls/src/wire.rs), so the replay keeps the fused picture inside a budget.
    convert observations --samples "$(samples_dir)" --feeds "${feeds// /,}" --budget-kb "$PICTURE_BUDGET_KB" \
        >"$dir/observations.tsv"
    chmod 0644 "$dir/observations.tsv"
    digest="$(sha256sum "$dir/observations.tsv" | cut -d' ' -f1)"
    if [ "$(cat "$dir/.replayed" 2>/dev/null)" = "$digest" ]; then
        echo "these observations were replayed by an earlier run"
        return 0
    fi
    echo "replaying $(wc -l <"$dir/observations.tsv") observations from: $feeds"
    # shellcheck disable=SC2016
    dc run --rm --no-deps -T -v "$dir:/feeds:ro" --entrypoint sh feed-source -c '
        tab="$(printf "\t")"; ok=0; refused=0
        while IFS="$tab" read -r feed kind entity at attrs; do
            if heimdall-source --identity-dir /identity --service "$feed" --addr heimdall-feed:7730 \
                --kind "$kind" --entity "$entity" --observed-at "$at" ${attrs:+--attrs "$attrs"} >/dev/null 2>/tmp/err; then
                ok=$((ok + 1))
            else
                refused=$((refused + 1)); [ "$refused" -le 5 ] && echo "refused $feed $entity: $(cat /tmp/err)"
            fi
        done < /feeds/observations.tsv
        echo "accepted $ok, refused $refused"
        [ "$ok" -gt 0 ] && [ "$refused" -eq 0 ]'
    echo "$digest" >"$dir/.replayed"
    local picture entities
    picture="$(dc run --rm -T picture 2>/dev/null)"
    entities="$(python3 -I -c 'import json, sys; print(len(json.load(sys.stdin)["entities"]))' <<<"$picture")" || {
        echo "the picture could not be read back"
        return 1
    }
    echo "the picture holds $entities entities in $(( ${#picture} / 1024 )) KiB"
    [ "$entities" -gt 0 ]
}

# Wait until every Forge job has run once, then fail if any did not sync, naming it.
wait_for_sync() {
    local jobs i ran failed
    jobs="$(python3 -I -c 'import json, sys; print(" ".join(j["id"] for j in json.load(open(sys.argv[1]))["jobs"]))' "$SITE/forge/jobs.json")"
    for ((i = 0; i < 60; i++)); do
        ran=0
        for job in $jobs; do
            dc logs --no-color forge-worker 2>/dev/null | grep -q "\"job\":\"$job\"" && ran=$((ran + 1))
        done
        [ "$ran" -eq "$(wc -w <<<"$jobs")" ] && break
        sleep 3
    done
    dc logs --no-color forge-worker | { grep '"message":"job run"' || true; } | sed 's/.*"job":"\([^"]*\)".*"message":"\([^"]*\)".*/\1: \2/' | sort -u
    failed="$(dc logs --no-color forge-worker | grep '"job run failed"' | sed 's/.*"job":"\([^"]*\)","reason":"\(.*\)"}.*/\1: \2/' | sort -u || true)"
    if [ -n "$failed" ]; then
        echo "these Forge jobs did not sync:"
        echo "$failed"
        return 1
    fi
    [ "$ran" -eq "$(wc -w <<<"$jobs")" ] || { echo "only $ran of $(wc -w <<<"$jobs") jobs ran within three minutes"; return 1; }
    echo "all $ran jobs synced"
}

# The current code for a base32 TOTP key: RFC 6238 with HMAC-SHA256, 6 digits, 30 s,
# as Midgard enrols it (services/iam/src/mfa.rs).
totp_now() {
    local key="$1" pad hexkey counter mac off bin
    pad=$(( (8 - ${#key} % 8) % 8 ))
    key+="$(printf '%*s' "$pad" '' | tr ' ' '=')"
    hexkey="$(printf '%s' "$key" | base32 -d | od -An -vtx1 | tr -d ' \n')"
    counter="$(printf '%016x' $(( $(date +%s) / 30 )))"
    mac="$(printf '%b' "$(sed 's/../\\x&/g' <<<"$counter")" |
        openssl dgst -sha256 -mac HMAC -macopt "hexkey:$hexkey" -binary | od -An -vtx1 | tr -d ' \n')"
    off=$(( 16#${mac:62:2} & 15 ))
    bin=$(( 16#${mac:$((off * 2)):8} & 0x7fffffff ))
    printf '%06d' $(( bin % 1000000 ))
}

json_string() { sed 's/["\\]/\\&/g' <<<"$1"; }

# Sign in as the first user, then read the schema, and the data Forge synced: the path
# a person takes in the console, over the same API.
check_login() {
    local body token totp="" types first count
    if [ -n "${LOGIN_CHECK_TOTP_KEY:-}" ]; then
        command -v openssl >/dev/null 2>&1 || { echo "openssl is missing: sign in by hand to check"; return 0; }
        totp=",\"totp\":\"$(totp_now "$LOGIN_CHECK_TOTP_KEY")\""
    fi
    body="{\"username\":\"$OPERATOR\",\"password\":\"$(json_string "$LOGIN_CHECK_PASSWORD")\"$totp}"
    token="$(curl -fsS -X POST http://127.0.0.1:7710/api/v1/login -H 'content-type: application/json' \
        --data-binary @- <<<"$body" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
    [ -n "$token" ] || { echo "the gateway refused $OPERATOR's sign-in"; return 1; }
    types="$(curl -fsS http://127.0.0.1:7710/api/v1/object-types -H "authorization: Bearer $token")"
    # The first type that holds objects: the one the check reads.
    first="$(python3 -I -c 'import json, sys
for t in json.load(sys.stdin):
    if str(t.get("instanceCount", "0")) != "0":
        print(t["apiName"]); break' <<<"$types")"
    [ -n "$first" ] || { echo "no object type holds any objects"; return 1; }
    echo "signed in; object types: $(grep -o '"apiName":"[^"]*"' <<<"$types" | cut -d'"' -f4 | xargs)"
    has forge || return 0
    count="$(curl -fsS -X POST http://127.0.0.1:7710/api/v1/query -H "authorization: Bearer $token" \
        -H 'content-type: application/json' -d "{\"objectType\":\"$first\"}" | grep -o "\"typeId\":\"$first\"" | wc -l)"
    echo "$OPERATOR can read $count $first object(s)"
    [ "$count" -gt 0 ] || { echo "$OPERATOR cannot read any synced $first: check clearance and purposes"; return 1; }
}

install_now() {
    step 9 "INSTALLING"
    STATUS=in-progress
    INSTALLED_AT="$(date -u +%FT%TZ)"
    install -d -m 0750 "$INSTALL_DIR"
    touch "$LOG"; chmod 0600 "$LOG"
    note "  Progress is logged to $LOG"
    echo
    run "Copying the Midgard source to $SRC" copy_source
    if [ -n "$SAMPLES_ZIP" ]; then
        run "Unpacking the full sample datasets" extract_samples
    fi
    if git -C "$REPO" rev-parse --short=12 HEAD >/dev/null 2>&1; then
        SOURCE_COMMIT="$(git -C "$REPO" rev-parse --short=12 HEAD)"
        git -C "$REPO" diff --quiet HEAD 2>/dev/null || SOURCE_COMMIT+="+local-changes"
    fi
    SOURCE_COMMIT="${SOURCE_COMMIT:-unknown}"
    save_state
    run "Building the Rust toolchain image (first time only)" build_toolchain
    run "Writing this server's configuration" write_site
    run "Building the Midgard services from source" dc build init
    if [ "$CONSOLE" = yes ]; then
        if [ "$(docker image inspect -f '{{index .Config.Labels "org.midgard.source"}}' "$CONSOLE_IMAGE" 2>/dev/null)" = "$SOURCE_COMMIT" ] &&
            [[ "$SOURCE_COMMIT" != unknown && "$SOURCE_COMMIT" != *+local-changes ]]; then
            ok "The web console is already built from $SOURCE_COMMIT."
        else
            run "Building the web console" docker build -f "$SRC/deploy/installer/console.Dockerfile" \
                --label "org.midgard.source=$SOURCE_COMMIT" -t "$CONSOLE_IMAGE" "$SRC"
        fi
    fi
    if has mimir && [ "$MODEL" = granite ]; then
        run "Fetching, verifying and signing the Granite model" stage_model
    fi
    if [ "$FRESH_ENCLOSURE" = 1 ]; then
        run "Removing the previous enclosure" dc down -v --remove-orphans
        rm -rf "$INSTALL_DIR/admin-passkeys"
    fi
    dc stop gateway >>"$LOG" 2>&1 || true
    run "Creating the enclosure's keys and service identities" dc run --rm init
    enrol_operator
    enrol_admins
    if [ -n "$(feed_list)" ]; then
        run "Issuing an identity to each Heimdall feed" issue_feed_identities
    fi
    local count; count="$(services_of | wc -w)"
    # shellcheck disable=SC2046
    run "Starting $count service$([ "$count" = 1 ] || echo s) and waiting until each is ready" dc up -d --wait $(services_of)
    run "Checking the gateway answers" curl -fsS http://127.0.0.1:7710/api/v1/health
    has forge && run "Waiting for Forge's first sync into the fabric" wait_for_sync
    if [ -n "${LOGIN_CHECK_PASSWORD:-}" ]; then
        run "Signing in as $OPERATOR and reading the data" check_login
    fi
    unset LOGIN_CHECK_PASSWORD LOGIN_CHECK_TOTP_KEY
    if has mimir; then
        if [ "$MODEL" = granite ]; then
            run "Asking Mimir a question over PQ-mTLS" dc run --rm probe --prompt "In one sentence, what is an audit ledger?" --max-tokens 48
        else
            run "Making a PQ-mTLS inference call to Mimir" dc run --rm probe
        fi
    fi
    has bifrost && run "Reading the Bifrost fleet as an operator" dc run --rm fleet-status
    has heimdall && run "Reading the Heimdall picture as an analyst" dc run --rm picture
    if [ -n "$(feed_list)" ]; then
        run "Replaying the Heimdall feeds and checking the picture" replay_feeds
    fi
    [ "$CONSOLE" = yes ] && run "Checking the web console is served" curl -fsS -o /dev/null http://127.0.0.1:5173/
    ln -sf "$SRC/deploy/installer/mg-install" /usr/local/bin/mg-install
    STATUS=complete
    save_state
    write_report
    finish
}

tunnel_command() {
    if [ "$CONSOLE" = yes ]; then
        echo "ssh -N -L 5173:127.0.0.1:5173 -L 7710:127.0.0.1:7710"
    else
        echo "ssh -N -L 7710:127.0.0.1:7710"
    fi
}

host_address() {
    local h
    h="$(hostname -f 2>/dev/null || hostname)"
    [[ "$h" == *.* ]] || h="$(hostname -I 2>/dev/null | awk '{ print $1 }')"
    echo "${h:-your-server}"
}

write_report() {
    # shellcheck disable=SC1090
    . "$HERE/profiles/$PROFILE/profile.env"
    local f="$INSTALL_DIR/INSTALL_REPORT.md" n
    {
        echo "# Midgard install report"
        echo
        echo "Written by mg-install $MG_INSTALL_VERSION on $(date -u '+%d %B %Y at %H:%M UTC'). It holds no secrets."
        echo
        echo "| | |"
        echo "|---|---|"
        echo "| Server | $(host_address), $OS_NAME, $ARCH, $CPUS cores, $((RAM_MB / 1024)) GB |"
        echo "| Use | $PROFILE_TITLE (profile \`$PROFILE\`) |"
        echo "| Products | Midgard$(for c in $COMPONENTS; do printf ', %s' "${c^}"; done) |"
        echo "| Model | $(has mimir && { [ "$MODEL" = granite ] && echo 'Granite 3.3 2B Instruct, CPU' || echo 'reference engine'; } || echo 'none') |"
        echo "| Web console | $CONSOLE |"
        if has forge && [ -n "$PROFILE_SAMPLES" ]; then
            local origin="the open set in the repository"
            [ -n "$SAMPLES_ZIP" ] && origin="$SAMPLES_ZIP"
            echo "| Recorded datasets | ${PROFILE_SAMPLES//,/, }, from $origin |"
        fi
        if has heimdall; then
            echo "| Heimdall feeds | $(feed_list | sed 's/ /, /g') |"
        fi
        echo "| Source | \`$SOURCE_COMMIT\`, copied to \`$SRC\` |"
        echo "| Services | $(services_of) |"
        echo "| First user | \`$OPERATOR\` (operator, $PROFILE_CLEARANCE, purposes $PROFILE_PURPOSES, second factor $OPERATOR_TOTP) |"
        [ -n "$ADMIN_1" ] && echo "| Administrators | \`$ADMIN_1\`, \`$ADMIN_2\` (IAM-Admin) |"
        echo
        echo "## Reach it from your computer"
        echo
        echo '```bash'
        echo "$(tunnel_command) <you>@$(host_address)"
        echo '```'
        echo
        if [ "$CONSOLE" = yes ]; then
            echo "Then open http://localhost:5173 and sign in as \`$OPERATOR\`."
        else
            echo "Then call the API at http://localhost:7710/api/v1, signing in as \`$OPERATOR\` (no web console is installed)."
        fi
        echo
        echo "## Guidance for this use"
        echo
        for n in "${PROFILE_NOTES[@]}"; do echo "- $n"; done
        echo
        local credits
        credits="$(convert credits --samples "$(samples_dir)" --datasets "$PROFILE_SAMPLES" --feeds "$(feed_list)" 2>/dev/null || true)"
        if [ -n "$credits" ]; then
            echo "## Data credits"
            echo
            echo "The recorded datasets and feeds carry their sources' licences. Keep these credits wherever the data is shown or shared."
            echo
            echo "$credits"
            echo
        fi
        echo "## Look after it"
        echo
        echo "| Task | Command |"
        echo "|---|---|"
        echo "| See what is running | \`sudo mg-install status\` |"
        echo "| Read a service's log | \`sudo mg-install logs gateway\` |"
        echo "| Add a user | \`sudo mg-install add-user\` |"
        echo "| Back up | \`sudo mg-install backup\` |"
        echo "| Stop, start | \`sudo mg-install stop\`, \`sudo mg-install start\` |"
        echo "| Remove (keeps data) | \`sudo mg-install uninstall\` |"
        echo
        echo "The full guide is \`$SRC/deploy/installer/README.md\`."
    } >"$f"
    chmod 0640 "$f"
}

card_line() { printf '  %s│%s %-*s %s│%s\n' "$C_FAINT" "$R" "$(( $(cols) - 8 ))" "$1" "$C_FAINT" "$R"; }

finish() {
    echo
    rule
    banner keep
    local w=$(( $(cols) - 6 )) host
    host="$(host_address)"
    printf '  %s%s%sMIDGARD IS INSTALLED AND RUNNING%s\n\n' "$C_SECURE" "$B" "" "$R"
    printf '  %s┌%s┐%s\n' "$C_FAINT" "$(printf '%*s' "$w" '' | sed 's/ /─/g')" "$R"
    card_line "OPEN IT FROM YOUR OWN COMPUTER"
    card_line ""
    card_line "1. In a terminal on your computer, open the tunnel and leave it running:"
    card_line "   $(tunnel_command) you@$host"
    if [ "$CONSOLE" = yes ]; then
        card_line "2. In your browser, open  http://localhost:5173"
    else
        card_line "2. The API is at  http://localhost:7710/api/v1  (no console installed)"
    fi
    card_line "3. Sign in as  $OPERATOR$([ "$OPERATOR_TOTP" = yes ] && echo '  with the code from your authenticator app')"
    printf '  %s└%s┘%s\n\n' "$C_FAINT" "$(printf '%*s' "$w" '' | sed 's/ /─/g')" "$R"
    if [ -n "$ADMIN_1" ]; then
        printf '  %s%sDO THIS NEXT%s\n' "$C_WARN" "$B" "$R"
        say "Give each administrator their passkey file, then delete it from this server:"
        note "  $INSTALL_DIR/admin-passkeys/$ADMIN_1.passkey"
        note "  $INSTALL_DIR/admin-passkeys/$ADMIN_2.passkey"
        say "Whoever holds a passkey file can act as that administrator. Keep each in its"
        say "owner's encrypted password manager or on encrypted media, never in email or chat."
        say "Afterwards run:  sudo mg-install handed-over"
        echo
    fi
    say "A record of this install, with the guidance for your use, is in"
    note "  $INSTALL_DIR/INSTALL_REPORT.md"
    say "Manage it with  ${B}sudo mg-install status${R}, ${B}add-user${R}, ${B}backup${R}, ${B}logs${R}."
    echo
}

wizard() {
    need_root
    local dir="${ANSWER[INSTALL_DIR]:-${MG_INSTALL_DIR:-$DEFAULT_DIR}}"
    set_dirs "$dir"
    if load_state; then
        INSTALLED_PROFILE="$PROFILE"
        if [ "$STATUS" = complete ] && [ "$UNATTENDED" = 0 ]; then
            banner
            say "Midgard is already installed in $INSTALL_DIR ($PROFILE, $(services_of))."
            echo
            say "  1  Check and repair it, with the same choices"
            say "  2  Change the choices and reinstall (data is kept)"
            say "  3  Leave it as it is"
            choose ACTION 1 repair change leave
            case "$REPLY" in
                leave) exit 0 ;;
                repair) facts; install_now; return ;;
            esac
        fi
    fi
    if [ "$UNATTENDED" = 1 ]; then
        banner
        say "Unattended install from the answers file."
        echo
        preflight || die "The server check failed."
        if [ -z "$PYTHON_VERSION" ]; then
            [ "${ANSWER[INSTALL_PYTHON]:-no}" = yes ] || die "Python 3 is not installed and INSTALL_PYTHON is not yes."
            install -d -m 0750 "$INSTALL_DIR"; touch "$LOG"
            run "Installing Python 3" install_python
            facts
        fi
        if [ -z "$DOCKER_VERSION" ]; then
            [ "${ANSWER[INSTALL_DOCKER]:-no}" = yes ] || die "Docker is not installed and INSTALL_DOCKER is not yes."
            install -d -m 0750 "$INSTALL_DIR"; touch "$LOG"
            run "Installing Docker" install_docker
            facts
        fi
        step_profile
        step_components
        step_model
        step_data
        step_people
        step_review
    else
        [ -t 0 ] || die "Run the installer in a terminal, or pass --answers FILE for an unattended install."
        step_welcome
        step_server
        step_profile
        step_components
        step_model
        step_data
        step_people
        step_review
    fi
    install_now
}

