# feed_families [ZIP]: one line per family: name, feeds available, feeds known, and
# the available feeds' names, from the repository's samples or from the zip.
feed_families() {
    python3 -I - "$REPO/samples/catalogue.json" "$REPO/samples" "${1:-}" <<'EOF'
import json, os, sys, zipfile
catalogue, repo, archive = sys.argv[1], sys.argv[2], sys.argv[3]
feeds = json.load(open(catalogue))["observations"]
if archive:
    have = {os.path.basename(n)[:-5] for n in zipfile.ZipFile(archive).namelist()
            if "/4-heimdall-observations/" in n and n.endswith(".json") and "__MACOSX" not in n}
else:
    have = {f[:-5] for f in os.listdir(os.path.join(repo, "4-heimdall-observations"))}
families = {}
for feed, entry in feeds.items():
    families.setdefault(entry["family"], []).append(feed)
for family, members in families.items():
    present = [f for f in members if f in have]
    print(family, len(present), len(members), ",".join(present) or "-")
EOF
}

valid_samples_zip() {
    python3 -I -c 'import sys, zipfile; z = zipfile.ZipFile(sys.argv[1]); sys.exit(not any("/1-configuration/" in n for n in z.namelist()))' "$1" 2>/dev/null
}

