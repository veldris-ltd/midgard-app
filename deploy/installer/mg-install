#!/usr/bin/env bash
# shellcheck disable=SC2001  # sed reads more plainly than parameter expansion here
# mg-install: install the Midgard Suite, whole or in part, on one Linux server, step by
# step, and manage it afterwards. [RC-33] [NFR-SEC-1] [NFR-PRV-1] [NFR-AVA-1]
#
#   sudo deploy/installer/mg-install                  the guided installer
#   sudo deploy/installer/mg-install --answers FILE   the same, unattended
#   deploy/installer/mg-install check                 check this server, change nothing
#   sudo mg-install status | start | stop | restart | logs [SERVICE]
#   sudo mg-install add-user | backup [DIR] | uninstall [--purge]
#
# It drives the deployment the repository already runs and tests, docker compose
# (deploy/compose), and adds only what a server needs around it: a use-case profile
# with a starter schema, the choice of products, the first users enrolled before
# anything starts, an optional web console, and checks that each chosen service
# answers. Nothing it starts listens on anything but the server's loopback address.
#
# The images are built on the server from this checkout. They are not signed release
# images: no release has been tagged yet (docs/compliance/GA_READINESS.md).
set -Eeuo pipefail

MG_INSTALL_VERSION=0.1.0
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
DEFAULT_DIR=/opt/midgard
TOOLCHAIN_IMAGE=midgard-acceptance:1.82.0
DEV_IMAGE=midgard/dev:local
CONSOLE_IMAGE=midgard/console:local
GRANITE_GGUF=granite-3.3-2b-instruct-Q4_K_M.gguf
GRANITE_URL="https://huggingface.co/ibm-granite/granite-3.3-2b-instruct-GGUF/resolve/7cdf86ccd1f1bb3491c9b7017b033f2e51367397/$GRANITE_GGUF"
PROFILES=(legal medical military utilities)
FEED_FAMILIES=(aviation maritime energy water transport communications hazards information)
PICTURE_BUDGET_KB=1100
COMPONENTS_ALL=(forge mimir bifrost heimdall)

# ---- theme -----------------------------------------------------------------------------
# The suite's palette (ui/design-system/src/tokens/colors.css): one accent per product,
# status colours for state only. Truecolor where the terminal says it has it, the
# nearest 256-colour index otherwise, and nothing when NO_COLOR is set or output is not
# a terminal.

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    if [ "${COLORTERM:-}" = truecolor ] || [ "${COLORTERM:-}" = 24bit ]; then
        rgb() { printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3"; }
    else
        rgb() { printf '\033[38;5;%dm' "$4"; }
    fi
    C_MIDGARD="$(rgb 202 29 37 160)"   C_FORGE="$(rgb 217 110 30 166)"
    C_MIMIR="$(rgb 35 168 182 37)"     C_BIFROST="$(rgb 125 92 230 98)"
    C_HEIMDALL="$(rgb 201 154 34 178)" C_SECURE="$(rgb 33 192 122 35)"
    C_WARN="$(rgb 240 168 36 214)"     C_DANGER="$(rgb 202 29 37 160)"
    C_INFO="$(rgb 61 139 255 33)"      C_BODY="$(rgb 233 235 238 255)"
    C_MUTED="$(rgb 145 153 163 246)"   C_FAINT="$(rgb 74 79 86 240)"
    B=$'\033[1m' R=$'\033[0m'
    INTERACTIVE_TERM=1
else
    C_MIDGARD="" C_FORGE="" C_MIMIR="" C_BIFROST="" C_HEIMDALL="" C_SECURE=""
    C_WARN="" C_DANGER="" C_INFO="" C_BODY="" C_MUTED="" C_FAINT="" B="" R=""
    INTERACTIVE_TERM=0
fi

accent_of() {
    case "$1" in
        core) printf '%s' "$C_MIDGARD" ;; forge) printf '%s' "$C_FORGE" ;;
        mimir) printf '%s' "$C_MIMIR" ;; bifrost) printf '%s' "$C_BIFROST" ;;
        heimdall) printf '%s' "$C_HEIMDALL" ;; console) printf '%s' "$C_INFO" ;;
    esac
}

cols() { local c; c="$(tput cols 2>/dev/null || echo 80)"; [ "$c" -gt 100 ] && c=100; echo "$c"; }
rule() { printf '%s' "$C_FAINT"; printf '%*s' "$(cols)" '' | sed 's/ /─/g'; printf '%s\n' "$R"; }

banner() {
    [ "$INTERACTIVE_TERM" = 1 ] && [ "${1:-}" != keep ] && printf '\033[2J\033[H'
    echo
    if [ "$(cols)" -ge 60 ]; then
        printf '%s%s' "$C_MIDGARD" "$B"
        cat <<'EOF'
  ███╗   ███╗██╗██████╗  ██████╗  █████╗ ██████╗ ██████╗
  ████╗ ████║██║██╔══██╗██╔════╝ ██╔══██╗██╔══██╗██╔══██╗
  ██╔████╔██║██║██║  ██║██║  ███╗███████║██████╔╝██║  ██║
  ██║╚██╔╝██║██║██║  ██║██║   ██║██╔══██║██╔══██╗██║  ██║
  ██║ ╚═╝ ██║██║██████╔╝╚██████╔╝██║  ██║██║  ██║██████╔╝
  ╚═╝     ╚═╝╚═╝╚═════╝  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═════╝
EOF
        printf '%s' "$R"
    else
        printf '  %s%sMIDGARD%s\n' "$C_MIDGARD" "$B" "$R"
    fi
    printf '  %s██████%s██████%s██████%s██████%s██████%s\n' \
        "$C_MIDGARD" "$C_FORGE" "$C_MIMIR" "$C_BIFROST" "$C_HEIMDALL" "$R"
    printf '  %sTHE SOVEREIGN ENCLOSURE  ·  SERVER INSTALLER %s%s\n\n' "$C_MUTED" "$MG_INSTALL_VERSION" "$R"
}

STEP_TOTAL=9
step() {
    local n="$1" title="$2" bar="" i
    for ((i = 1; i <= STEP_TOTAL; i++)); do
        if [ "$i" -le "$n" ]; then bar+="${C_MIDGARD}▰"; else bar+="${C_FAINT}▱"; fi
    done
    banner
    printf '  %s%s  %sSTEP %d OF %d  ·  %s%s\n' "$bar" "$R" "$C_MUTED" "$n" "$STEP_TOTAL" "$title" "$R"
    rule
    echo
}

say()  { printf '  %s%s%s\n' "$C_BODY" "$*" "$R"; }
note() { printf '  %s%s%s\n' "$C_MUTED" "$*" "$R"; }
ok()   { printf '  %s✓%s %s\n' "$C_SECURE" "$R" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$R" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$C_DANGER" "$R" "$*"; }
die()  { echo; bad "$*"; echo; exit 1; }
label() { printf '  %s%s%-22s%s' "$C_MUTED" "$B" "$1" "$R"; }
wrap() { fold -s -w "$(( $(cols) - 6 ))" | sed 's/^/    /'; }

# ---- prompts ---------------------------------------------------------------------------
# Unattended runs take every answer from the answers file; a missing answer stops the
# run rather than guessing.

UNATTENDED=0
declare -A ANSWER=()

pause() {
    [ "$UNATTENDED" = 1 ] && return 0
    echo
    printf '  %sPress Enter to continue, or Ctrl+C to stop.%s ' "$C_MUTED" "$R"
    read -r _
}

# ask KEY "Question" DEFAULT -> REPLY
ask() {
    local key="$1" q="$2" def="${3:-}"
    if [ "$UNATTENDED" = 1 ]; then
        REPLY="${ANSWER[$key]:-$def}"
        [ -n "$REPLY" ] || die "the answers file has no $key"
        return 0
    fi
    if [ -n "$def" ]; then
        printf '  %s%s%s %s[%s]%s ' "$C_BODY" "$q" "$R" "$C_MUTED" "$def" "$R"
    else
        printf '  %s%s%s ' "$C_BODY" "$q" "$R"
    fi
    read -r REPLY
    REPLY="${REPLY:-$def}"
}

# yes_no KEY "Question" yes|no
yes_no() {
    local key="$1" q="$2" def="$3" hint
    if [ "$UNATTENDED" = 1 ]; then
        REPLY="${ANSWER[$key]:-$def}"
    else
        [ "$def" = yes ] && hint="Y/n" || hint="y/N"
        while :; do
            printf '  %s%s%s %s[%s]%s ' "$C_BODY" "$q" "$R" "$C_MUTED" "$hint" "$R"
            read -r REPLY
            case "${REPLY,,}" in
                "") REPLY="$def"; break ;;
                y | yes) REPLY=yes; break ;;
                n | no) REPLY=no; break ;;
            esac
        done
    fi
    [ "$REPLY" = yes ]
}

# choose KEY DEFAULT_INDEX option... -> REPLY (the chosen option)
choose() {
    local key="$1" def="$2"; shift 2
    local options=("$@") n
    if [ "$UNATTENDED" = 1 ]; then
        REPLY="${ANSWER[$key]:-${options[$((def - 1))]}}"
        printf '%s\n' "${options[@]}" | grep -qx -- "$REPLY" || die "$key must be one of: ${options[*]}"
        return 0
    fi
    while :; do
        printf '  %sChoose 1-%d%s %s[%d]%s ' "$C_BODY" "${#options[@]}" "$R" "$C_MUTED" "$def" "$R"
        read -r n
        n="${n:-$def}"
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#options[@]}" ]; then
            REPLY="${options[$((n - 1))]}"
            return 0
        fi
        warn "Type a number from 1 to ${#options[@]}."
    done
}

# secret "Prompt" -> REPLY, read twice without echo, at least 12 characters
secret() {
    local first second
    while :; do
        printf '  %s%s%s ' "$C_BODY" "$1" "$R"; read -rs first; echo
        if [ "${#first}" -lt 12 ]; then warn "Use at least 12 characters."; continue; fi
        printf '  %sType it again:%s ' "$C_BODY" "$R"; read -rs second; echo
        if [ "$first" != "$second" ]; then warn "The two entries differ. Try again."; continue; fi
        REPLY="$first"
        return 0
    done
}

valid_name() { [[ "$1" =~ ^[a-z][a-z0-9._-]{1,31}$ ]]; }

# Answers files are read as KEY=VALUE lines, never executed.
ANSWER_KEYS="INSTALL_PYTHON FRESH SAMPLES_ZIP FEEDS INSTALL_DIR PROFILE COMPONENTS MODEL MODEL_FILE CONSOLE OPERATOR
  OPERATOR_PASSWORD_FILE OPERATOR_TOTP ADMIN_1 ADMIN_2 INSTALL_DOCKER CONFIRM"
read_answers() {
    local line key value
    [ -r "$1" ] || die "cannot read the answers file $1"
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$line")"
        [ -n "$line" ] || continue
        [[ "$line" == *=* ]] || die "answers: not KEY=VALUE: $line"
        key="${line%%=*}"; value="${line#*=}"
        value="${value#\"}"; value="${value%\"}"
        [[ " ${ANSWER_KEYS//$'\n'/ } " == *" $key "* ]] || die "answers: unknown key $key"
        ANSWER[$key]="$value"
    done <"$1"
    UNATTENDED=1
}

# ---- server facts ----------------------------------------------------------------------

OS_ID="" OS_NAME="" OS_CODENAME="" ARCH="" CPUS=0 RAM_MB=0
CPU_MODEL="" GPU="" GPU_MEM="" DISK_FREE_GB=0 DOCKER_VERSION="" COMPOSE_VERSION=""
PLESK="" TIER="" GEX131=0 PYTHON_VERSION=""

facts() {
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        OS_ID="$(. /etc/os-release; echo "${ID:-}")"
        OS_NAME="$(. /etc/os-release; echo "${PRETTY_NAME:-$ID}")"
        OS_CODENAME="$(. /etc/os-release; echo "${VERSION_CODENAME:-}")"
    fi
    ARCH="$(uname -m)"
    CPUS="$(nproc 2>/dev/null || echo 1)"
    RAM_MB="$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null || echo 0)"
    CPU_MODEL="$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo 2>/dev/null || true)"
    if command -v nvidia-smi >/dev/null 2>&1; then
        GPU="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || true)"
        GPU_MEM="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | head -1 || true)"
    fi
    if [ -z "$GPU" ] && command -v lspci >/dev/null 2>&1; then
        GPU="$(lspci 2>/dev/null | grep -iE 'vga|3d controller' | grep -i nvidia | head -1 | sed 's/^.*: //' || true)"
    fi
    PYTHON_VERSION=""
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then
        PYTHON_VERSION="$(python3 -c 'import platform; print(platform.python_version())')"
    fi
    if command -v docker >/dev/null 2>&1; then
        DOCKER_VERSION="$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
        COMPOSE_VERSION="$(docker compose version --short 2>/dev/null || true)"
    fi
    local where=/var/lib
    [ -n "$DOCKER_VERSION" ] && where="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib)"
    while [ ! -d "$where" ]; do where="$(dirname "$where")"; done
    DISK_FREE_GB="$(df -Pk "$where" | awk 'NR == 2 { print int($4 / 1048576) }')"
    if [ -d /usr/local/psa ] || command -v plesk >/dev/null 2>&1; then
        PLESK="$(cat /usr/local/psa/version 2>/dev/null | head -1 || echo detected)"
    fi
    if [[ "$CPU_MODEL" == *"Gold 5412U"* ]] && [[ "$GPU" == *"RTX PRO 6000"* ]]; then GEX131=1; fi
    if [ -n "$GPU" ] && [ "$CPUS" -ge 16 ] && [ "$RAM_MB" -ge 120000 ]; then TIER=G
    elif [ "$CPUS" -ge 8 ] && [ "$RAM_MB" -ge 30000 ]; then TIER=M
    elif [ "$CPUS" -ge 4 ] && [ "$RAM_MB" -ge 7500 ]; then TIER=S
    else TIER=below; fi
}

tier_name() {
    case "$1" in
        S) echo "S, evaluation (4+ cores, 8+ GB memory)" ;;
        M) echo "M, team server (8+ cores, 32+ GB memory)" ;;
        G) echo "G, GPU server (16+ cores, 128+ GB memory, NVIDIA GPU)" ;;
        *) echo "below the evaluation minimum" ;;
    esac
}
tier_rank() { case "$1" in S) echo 1 ;; M) echo 2 ;; G) echo 3 ;; *) echo 0 ;; esac; }

reachable() { curl -s -o /dev/null --max-time 8 "$1"; }

# preflight: print the server check. Returns 1 if the install cannot go ahead.
preflight() {
    local blocking=0 major
    facts
    label "Operating system"; echo "$OS_NAME ($ARCH)"
    label "Processor"; echo "$CPUS logical cores${CPU_MODEL:+, $CPU_MODEL}"
    label "Memory"; echo "$((RAM_MB / 1024)) GB"
    label "Free disk for images"; echo "$DISK_FREE_GB GB"
    label "GPU"; echo "${GPU:-none found}${GPU_MEM:+, $GPU_MEM}"
    label "Docker"; echo "${DOCKER_VERSION:-not installed}${COMPOSE_VERSION:+, compose $COMPOSE_VERSION}"
    label "Python"; echo "${PYTHON_VERSION:-not installed}"
    label "Sizing tier"; tier_name "$TIER"
    echo
    case "$ARCH" in
        x86_64 | aarch64) ok "Processor architecture is supported." ;;
        *) bad "Midgard builds for x86_64 and aarch64 only, not $ARCH."; blocking=1 ;;
    esac
    case "$OS_ID" in
        ubuntu | debian | rhel | rocky | almalinux | centos | fedora) ok "$OS_NAME is a supported distribution." ;;
        *) warn "$OS_NAME is not tested. The install may still work if Docker runs on it." ;;
    esac
    if [ "$TIER" = below ]; then
        bad "This server has fewer than 4 cores or 8 GB of memory. Midgard needs at least that to build and run."
        blocking=1
    else
        ok "Sizing tier $(tier_name "$TIER")."
    fi
    if [ "$DISK_FREE_GB" -lt 20 ]; then
        bad "Only $DISK_FREE_GB GB free where Docker keeps images. Free at least 20 GB (100 GB recommended)."
        blocking=1
    elif [ "$DISK_FREE_GB" -lt 100 ]; then
        warn "$DISK_FREE_GB GB free. Enough to install; 100 GB leaves room for data, backups and models."
    else
        ok "$DISK_FREE_GB GB free disk."
    fi
    if [ -n "$PYTHON_VERSION" ]; then
        ok "Python $PYTHON_VERSION, for preparing the sample data and feeds."
    else
        warn "Python 3.8 or later is not installed. The installer needs it to prepare data, and can install it."
    fi
    if [ -n "$DOCKER_VERSION" ]; then
        major="${DOCKER_VERSION%%.*}"
        if [ "$major" -lt 24 ]; then bad "Docker $DOCKER_VERSION is too old. Midgard needs Docker 24 or later."; blocking=1
        elif [ -z "$COMPOSE_VERSION" ]; then bad "The Docker Compose plugin is missing (docker compose version fails)."; blocking=1
        else ok "Docker $DOCKER_VERSION with Compose $COMPOSE_VERSION."; fi
    else
        warn "Docker is not installed. The installer can install it from Docker's own package repository."
    fi
    if command -v ss >/dev/null 2>&1; then
        local port
        for port in 7710 5173; do
            if ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; then
                if docker ps --format '{{.Names}} {{.Ports}}' 2>/dev/null | grep -q "^midgard-.*:$port->"; then
                    ok "Port $port is held by an existing Midgard install."
                else
                    bad "Port $port is already in use by another program. Midgard needs it on 127.0.0.1."
                    blocking=1
                fi
            fi
        done
    fi
    if [ -n "$PLESK" ]; then
        warn "Plesk is installed ($PLESK). Midgard listens on 127.0.0.1 only and does not touch Plesk's web server or ports 80 and 443."
        note "    If you later publish Midgard, do it through a Plesk domain's proxy settings with TLS, never by hand-editing Apache."
    fi
    if [ "$GEX131" = 1 ]; then
        ok "This looks like a Hetzner GEX131 (Xeon Gold 5412U with an RTX PRO 6000 Blackwell)."
    fi
    if [ -n "$GPU" ]; then
        note "    GPU found. Today the installer serves the AI model on the CPU: Midgard's GPU serving path is wired in"
        note "    its Kubernetes chart but has not yet been run end to end, so it is not offered here. The GPU is left untouched."
    fi
    if reachable https://registry-1.docker.io/v2/ && reachable https://static.rust-lang.org/; then
        ok "The internet is reachable for the build (Docker Hub and the Rust toolchain)."
    else
        bad "Cannot reach Docker Hub or static.rust-lang.org. The build needs them once, during installation."
        blocking=1
    fi
    return "$blocking"
}

# ---- install state ---------------------------------------------------------------------
# install.env records the choices (never a secret), so a second run resumes, and the
# management commands know what is installed.

INSTALL_DIR="" SRC="" SITE="" LOG="" STATE_FILE=""
PROFILE="" COMPONENTS="" MODEL=reference CONSOLE=yes SAMPLES_ZIP="" FEEDS="" OPERATOR="" OPERATOR_TOTP=yes
ADMIN_1="" ADMIN_2="" STATUS="" SOURCE_COMMIT="" INSTALLED_AT=""
STATE_KEYS="INSTALL_DIR PROFILE COMPONENTS MODEL CONSOLE SAMPLES_ZIP FEEDS OPERATOR OPERATOR_TOTP ADMIN_1 ADMIN_2 STATUS SOURCE_COMMIT INSTALLED_AT"

set_dirs() {
    INSTALL_DIR="$1"
    SRC="$INSTALL_DIR/src"
    SITE="$INSTALL_DIR/site"
    LOG="$INSTALL_DIR/install.log"
    STATE_FILE="$INSTALL_DIR/install.env"
}

save_state() {
    local k tmp
    tmp="$(mktemp "$INSTALL_DIR/.install.env.XXXX")"
    {
        echo "# Written by mg-install $MG_INSTALL_VERSION. Choices only: no secrets."
        for k in $STATE_KEYS; do printf '%s="%s"\n' "$k" "${!k}"; done
    } >"$tmp"
    chmod 0640 "$tmp"
    mv "$tmp" "$STATE_FILE"
}

load_state() {
    local line key value
    [ -r "$STATE_FILE" ] || return 1
    while IFS= read -r line; do
        [[ "$line" =~ ^([A-Z_0-9]+)=\"(.*)\"$ ]] || continue
        key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
        [[ " $STATE_KEYS " == *" $key "* ]] || continue
        [ "$key" = INSTALL_DIR ] && continue
        printf -v "$key" '%s' "$value"
    done <"$STATE_FILE"
}

find_install() {
    local dir="${MG_INSTALL_DIR:-$DEFAULT_DIR}"
    set_dirs "$dir"
    load_state || die "No Midgard install found in $dir. Run the installer first, or set MG_INSTALL_DIR."
}

has() { [[ " $COMPONENTS " == *" $1 "* ]]; }

services_of() {
    local s="gateway"
    has forge && s+=" forge-worker"
    has mimir && s+=" mimir-server"
    has mimir && [ "$MODEL" = granite ] && s+=" mimir-llamacpp"
    has bifrost && s+=" bifrost-fleet"
    has heimdall && s+=" heimdall-feed"
    [ "$CONSOLE" = yes ] && s+=" console"
    echo "$s"
}

dc() {
    local files=(-f "$SRC/deploy/compose/compose.yaml")
    has mimir && [ "$MODEL" = granite ] && files+=(-f "$SRC/deploy/compose/compose.granite.yaml")
    files+=(-f "$SITE/compose.site.yaml")
    docker compose "${files[@]}" "$@"
}

need_root() {
    [ "$(id -u)" = 0 ] || die "This needs administrator rights. Run it again with sudo: sudo $0 ${*:-}"
}

# ---- running steps ---------------------------------------------------------------------
# Each step's output goes to the log; the screen shows one line per step. On a failure
# the end of the log is shown, and running the installer again resumes: every step is
# safe to repeat.

run() {
    local title="$1"; shift
    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 pid rc start
    start="$(date +%s)"
    printf '\n==== %s  %s\n' "$(date -u +%FT%TZ)" "$title" >>"$LOG"
    if [ "$INTERACTIVE_TERM" = 1 ]; then
        (set -e; "$@") >>"$LOG" 2>&1 &
        pid=$!
        while kill -0 "$pid" 2>/dev/null; do
            printf '\r  %s%s%s %s %s(%ss)%s ' "$C_MIDGARD" "${frames:i++%10:1}" "$R" "$title" \
                "$C_FAINT" "$(($(date +%s) - start))" "$R"
            sleep 0.2
        done
        set +e; wait "$pid"; rc=$?; set -e
        printf '\r\033[K'
    else
        printf '  ... %s\n' "$title"
        set +e; (set -e; "$@") >>"$LOG" 2>&1; rc=$?; set -e
    fi
    if [ "$rc" -ne 0 ]; then
        bad "$title failed. The last lines of $LOG:"
        echo
        tail -n 25 "$LOG" | sed 's/^/      /'
        echo
        note "  Fix the cause above, then run the installer again: finished steps are skipped."
        exit 1
    fi
    ok "$title $C_FAINT($(($(date +%s) - start))s)$R"
}

# ---- docker ----------------------------------------------------------------------------

install_docker() {
    local family="$OS_ID"
    [ "$family" = linuxmint ] && family=ubuntu
    case "$family" in
        ubuntu | debian)
            export DEBIAN_FRONTEND=noninteractive
            apt-get update
            apt-get install -y ca-certificates curl
            install -m 0755 -d /etc/apt/keyrings
            curl -fsSL "https://download.docker.com/linux/$family/gpg" -o /etc/apt/keyrings/docker.asc
            chmod a+r /etc/apt/keyrings/docker.asc
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$family $OS_CODENAME stable" \
                >/etc/apt/sources.list.d/docker.list
            apt-get update
            apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
            ;;
        rhel | rocky | almalinux | centos | fedora)
            local repo=centos
            [ "$family" = fedora ] && repo=fedora
            [ "$family" = rhel ] && repo=rhel
            dnf -y install dnf-plugins-core
            dnf config-manager --add-repo "https://download.docker.com/linux/$repo/docker-ce.repo" ||
                dnf config-manager addrepo --from-repofile="https://download.docker.com/linux/$repo/docker-ce.repo"
            dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
            ;;
        *)
            echo "no automatic Docker install for $OS_ID" >&2
            return 1
            ;;
    esac
    systemctl enable --now docker
    docker version
}

install_python() {
    case "$OS_ID" in
        ubuntu | debian | linuxmint) DEBIAN_FRONTEND=noninteractive apt-get install -y python3 ;;
        rhel | rocky | almalinux | centos | fedora) dnf -y install python3 ;;
        *) echo "no automatic Python install for $OS_ID" >&2; return 1 ;;
    esac
    python3 --version
}

