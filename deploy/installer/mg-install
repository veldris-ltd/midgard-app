    echo
    local s state health
    for s in $(services_of); do
        state="$(docker inspect -f '{{.State.Status}}' "midgard-$s-1" 2>/dev/null || echo absent)"
        health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "midgard-$s-1" 2>/dev/null || true)"
        if [ "$state" = running ] && { [ -z "$health" ] || [ "$health" = healthy ]; }; then
            ok "$(printf '%-16s %s' "$s" "running${health:+, $health}")"
        else
            bad "$(printf '%-16s %s' "$s" "$state${health:+, $health}")"
        fi
    done
    echo
    if curl -fsS --max-time 3 http://127.0.0.1:7710/api/v1/health >/dev/null 2>&1; then
        ok "The gateway answers on http://127.0.0.1:7710"
    else
        bad "The gateway does not answer on http://127.0.0.1:7710"
    fi
}

cmd_add_user() {
    need_root
    find_install
    # shellcheck disable=SC1090
    . "$HERE/profiles/$PROFILE/profile.env"
    banner
    say "Add someone who can sign in. The gateway stops for a few seconds while they are enrolled."
    if [ -n "$ADMIN_1" ]; then
        note "  With administrators set up, you can instead enrol under dual control while it runs:"
        note "  see 'Administrators and online enrolment' in $SRC/README.md."
    fi
    echo
    local subject role clearance purposes totp=()
    while :; do ask NEW_USER "Username:" ""; valid_name "$REPLY" && break; warn "2-32 characters: a-z, 0-9, dot, underscore, hyphen."; done
    subject="$REPLY"
    say "  1  operator: reads and runs actions        2  viewer: reads only"
    choose ROLE 1 operator viewer; role="$REPLY"
    ask CLEARANCE "Clearance (open, internal, restricted, confidential):" "$PROFILE_CLEARANCE"; clearance="$REPLY"
    [[ "$clearance" =~ ^(open|internal|restricted|confidential)$ ]] || die "unknown clearance $clearance"
    ask PURPOSES "Purposes, comma separated:" "$PROFILE_PURPOSES"; purposes="$REPLY"
    # The gateway signs every session in for the purpose 'operations' (LOGIN_PURPOSE in
    # services/http-gateway/src/lib.rs), so a user without it could never sign in.
    [[ ",$purposes," == *,operations,* ]] || { purposes="operations,$purposes"; note "  Added 'operations': every sign-in is for that purpose today."; }
    if [ "$PROFILE_TOTP" = required ] || yes_no TOTP "Require an authenticator app code?" yes; then totp=(--totp); fi
    secret "Password for $subject:"
    local password="$REPLY" out
    dc stop gateway >/dev/null 2>&1
    if out="$(printf '%s\n' "$password" | dc run --rm --no-deps -T --entrypoint mg-admin init user add \
        --state-dir /vol/core-state --subject "$subject" --roles "$role" --clearance "$clearance" \
        --purposes "$purposes" "${totp[@]}" 2>&1)"; then
        unset password
        ok "Enrolled $subject."
        local uri
        uri="$(grep -o 'otpauth://[^[:space:]]*' <<<"$out" | head -1 || true)"
        if [ -n "$uri" ]; then
            command -v qrencode >/dev/null 2>&1 && qrencode -t ANSIUTF8 -m 2 "$uri" | sed 's/^/    /'
            label "Authenticator key"; sed -n 's/.*[?&]secret=\([A-Z2-7]*\).*/\1/p' <<<"$uri" | sed 's/.\{4\}/& /g'
            note "  Shown once. Give it to $subject in person or over a secure channel."
        fi
    else
        unset password
        bad "Enrolling $subject failed:"; grep -v 'otpauth://' <<<"$out" | sed 's/^/      /'
    fi
    dc up -d --wait gateway >/dev/null 2>&1 && ok "The gateway is running again."
}

cmd_backup() {
    need_root
    find_install
    local dest v n=0
    dest="${1:-/var/backups/midgard}/$(date -u +%Y%m%dT%H%M%SZ)"
    install -d -m 0700 "$dest"
    banner
    say "Backing up every Midgard volume to $dest"
    note "  The stores are encrypted at rest, but the archive of core-state holds the enclosure's"
    note "  sealed keys. Protect the backup as you would the server itself."
    echo
    dc stop >/dev/null 2>&1
    for v in $(docker volume ls -q --filter label=com.docker.compose.project=midgard) midgard-models midgard-model-signing; do
        docker volume inspect "$v" >/dev/null 2>&1 || continue
        docker run --rm --network none -u 0 -v "$v:/v:ro" -v "$dest:/b" "$DEV_IMAGE" \
            tar -C /v -czf "/b/$v.tar.gz" . && ok "$v" && n=$((n + 1))
    done
    (cd "$dest" && sha256sum ./*.tar.gz >SHA256SUMS)
    cp "$STATE_FILE" "$dest/install.env"
    chmod 0600 "$dest"/*
    # shellcheck disable=SC2046
    dc up -d --wait $(services_of) >/dev/null 2>&1 && ok "Services restarted."
    echo
    ok "$n volumes saved, with SHA256SUMS. Restore steps: $SRC/deploy/installer/README.md#restore"
}

cmd_uninstall() {
    need_root
    find_install
    banner
    if [ "${1:-}" = --purge ]; then
        warn "This deletes Midgard and ALL its data: keys, users, ledgers, datasets, models."
        say "There is no undo. Take a backup first (sudo mg-install backup) if in doubt."
        ask PURGE "Type DELETE to confirm:" ""
        [ "$REPLY" = DELETE ] || die "Nothing was deleted."
        dc down -v --remove-orphans
        docker volume rm midgard-models midgard-model-signing >/dev/null 2>&1 || true
        docker image rm "$DEV_IMAGE" "$CONSOLE_IMAGE" >/dev/null 2>&1 || true
        rm -f /usr/local/bin/mg-install
        rm -rf "$INSTALL_DIR"
        ok "Midgard and its data are removed. The toolchain image $TOOLCHAIN_IMAGE and Docker remain."
    else
        dc down --remove-orphans
        STATUS=stopped; save_state
        ok "The services are removed. Data volumes and $INSTALL_DIR are kept."
        note "  Run the installer again to bring it back, or 'uninstall --purge' to delete everything."
    fi
}

cmd_handed_over() {
    need_root
    find_install
    local keys="$INSTALL_DIR/admin-passkeys" a
    for a in $ADMIN_1 $ADMIN_2; do
        if [ -f "$keys/$a.passkey" ]; then
            shred -u "$keys/$a.passkey" 2>/dev/null || rm -f "$keys/$a.passkey"
            touch "$keys/.$a.handed-over"
            ok "Removed $a's passkey from this server."
        fi
    done
}

start_services() {
    # shellcheck disable=SC2046
    dc up -d --wait $(services_of)
}

usage() {
    cat <<EOF
mg-install $MG_INSTALL_VERSION: install and manage the Midgard Suite on one server.

  sudo mg-install                     guided install (or resume, repair, change)
  sudo mg-install --answers FILE      unattended install; see deploy/installer/answers.example
  mg-install check                    check this server; changes nothing
  sudo mg-install status              what is running, and is it healthy
  sudo mg-install start | stop | restart
  sudo mg-install logs [SERVICE]      e.g. gateway, mimir-server, forge-worker
  sudo mg-install add-user            enrol someone who can sign in
  sudo mg-install backup [DIR]        archive every volume (default /var/backups/midgard)
  sudo mg-install handed-over         delete administrator passkeys once handed over
  sudo mg-install uninstall [--purge] remove the services; --purge also deletes all data

The install folder is $DEFAULT_DIR; set MG_INSTALL_DIR to use another.
EOF
}

main() {
    case "${1:-install}" in
        -h | --help | help) usage ;;
        --version) echo "mg-install $MG_INSTALL_VERSION" ;;
        install) wizard ;;
        --answers) [ -n "${2:-}" ] || die "--answers needs a file"; read_answers "$2"; wizard ;;
        check)
            banner
            if preflight; then echo; ok "This server can run Midgard."
            else echo; bad "Fix the items marked ✗ first."; exit 1; fi ;;
        status) cmd_status ;;
        start) need_root; find_install; start_services ;;
        stop) need_root; find_install; dc stop ;;
        restart) need_root; find_install; dc restart ;;
        logs) need_root; find_install; dc logs --tail 200 -f ${2:+"$2"} ;;
        add-user) cmd_add_user ;;
        backup) cmd_backup "${2:-}" ;;
        handed-over) cmd_handed_over ;;
        uninstall) cmd_uninstall "${2:-}" ;;
        *) usage; exit 2 ;;
    esac
}

main "$@"
