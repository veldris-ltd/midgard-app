# An enclosure keeps the schema it was created with, so moving an install to another
# profile needs a fresh enclosure: the new profile's Forge jobs would not fit the old
# schema. Ask, plainly, before that deletes anything.
FRESH_ENCLOSURE=0 INSTALLED_PROFILE=""
confirm_profile_change() {
    [ -n "${INSTALLED_PROFILE:-}" ] && [ "$PROFILE" != "$INSTALLED_PROFILE" ] || return 0
    echo
    warn "This server's enclosure was created for '$INSTALLED_PROFILE', with that profile's schema."
    say "Switching to '$PROFILE' needs a fresh enclosure. That deletes the current users, keys,"
    say "ledgers and data. Take a backup first (sudo mg-install backup) if you may need them."
    echo
    if [ "$UNATTENDED" = 1 ]; then
        REPLY="${ANSWER[FRESH]:-}"
    else
        ask FRESH "Type DELETE to start a fresh enclosure, or press Enter to keep '$INSTALLED_PROFILE':" ""
    fi
    if [ "$REPLY" = DELETE ]; then
        FRESH_ENCLOSURE=1
        OPERATOR="" ADMIN_1="" ADMIN_2=""
    else
        PROFILE="$INSTALLED_PROFILE"
        # shellcheck disable=SC1090
        . "$HERE/profiles/$PROFILE/profile.env"
        ok "Keeping the '$PROFILE' profile."
    fi
}

