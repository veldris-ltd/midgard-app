        forge) title="Forge"; desc="Data operations: syncs files, databases and object stores into Midgard on a schedule." ;;
        mimir) title="Mimir"; desc="Local AI: answers questions on this server. No data leaves it." ;;
        bifrost) title="Bifrost"; desc="Delivery: records which version each installation runs, and drift from its channel." ;;
        heimdall) title="Heimdall"; desc="Operational picture: fuses signed observations from feeds into one picture." ;;
