{
  "version": 1,
  "jobs": [
    { "id": "units", "every": 600,
      "source": { "file": "units.csv",
                  "columns": [ { "name": "key", "type": "text" },
                               { "name": "name", "type": "text" },
                               { "name": "specialty", "type": "text" } ] },
      "objects": { "type": "care_unit", "key": "key", "marking": "internal",
                   "purposes": ["operations", "direct-care"],
                   "properties": { "name": "name", "specialty": "specialty" } } },
    { "id": "patients", "every": 300,
      "source": { "file": "patients.csv",
                  "columns": [ { "name": "pseudonym", "type": "text" },
                               { "name": "birth_year", "type": "int", "nullable": true },
                               { "name": "pathway", "type": "text" } ] },
      "objects": { "type": "patient", "key": "pseudonym", "marking": "confidential",
                   "purposes": ["operations", "direct-care"],
                   "properties": { "pseudonym": "pseudonym", "birth_year": "birth_year",
                                   "pathway": "pathway" } } },
    { "id": "encounters", "every": 120,
      "source": { "file": "encounters.csv",
                  "columns": [ { "name": "reference", "type": "text" },
                               { "name": "kind", "type": "text" },
                               { "name": "occurred", "type": "text" },
                               { "name": "review", "type": "text" },
                               { "name": "patient", "type": "text" },
                               { "name": "unit", "type": "text" } ] },
      "objects": { "type": "encounter", "key": "reference", "marking": "confidential",
                   "purposes": ["operations", "direct-care"],
                   "properties": { "reference": "reference", "kind": "kind",
                                   "occurred": "occurred", "review": "review" } },
      "links": [ { "type": "encounter_patient", "from": "reference", "to": "patient" },
                 { "type": "encounter_unit", "from": "reference", "to": "unit" } ] }
  ]
}
