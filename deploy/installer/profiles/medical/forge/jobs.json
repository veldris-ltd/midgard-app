{
  "version": 1,
  "jobs": [
    {
      "id": "organisations",
      "every": 600,
      "source": {
        "file": "organisations.csv",
        "columns": [
          {
            "name": "ods_code",
            "type": "text"
          },
          {
            "name": "name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "kind",
            "type": "text",
            "nullable": true
          }
        ]
      },
      "objects": {
        "type": "organisation",
        "key": "ods_code",
        "marking": "internal",
        "purposes": [
          "operations",
          "direct-care"
        ],
        "properties": {
          "ods_code": "ods_code",
          "name": "name",
          "kind": "kind"
        }
      }
    },
    {
      "id": "care_units",
      "every": 600,
      "source": {
        "file": "care_units.csv",
        "columns": [
          {
            "name": "key",
            "type": "text"
          },
          {
            "name": "name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "treatment_function",
            "type": "text",
            "nullable": true
          },
          {
            "name": "treatment_function_code",
            "type": "text",
            "nullable": true
          },
          {
            "name": "ods_site",
            "type": "text",
            "nullable": true
          },
          {
            "name": "organisation",
            "type": "text",
            "nullable": true
          }
        ]
      },
      "objects": {
        "type": "care_unit",
        "key": "key",
        "marking": "internal",
        "purposes": [
          "operations",
          "direct-care"
        ],
        "properties": {
          "name": "name",
          "treatment_function": "treatment_function",
          "treatment_function_code": "treatment_function_code",
          "ods_site": "ods_site"
        }
      },
      "links": [
        {
          "type": "unit_organisation",
          "from": "key",
          "to": "organisation"
        }
      ]
    },
