            "name": "pathway",
            "type": "text",
            "nullable": true
          }
        ]
      },
      "objects": {
        "type": "patient",
        "key": "pseudonym",
        "marking": "confidential",
        "purposes": [
          "operations",
          "direct-care"
        ],
        "properties": {
          "pseudonym": "pseudonym",
          "birth_year": "birth_year",
          "pathway": "pathway"
        }
