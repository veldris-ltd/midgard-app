{
  "version": 1,
  "objectTypes": [
    { "id": "unit", "title": "Unit",
      "properties": [ { "name": "designation", "type": "text", "required": true },
                      { "name": "echelon", "type": "text" },
                      { "name": "readiness", "type": "text" } ] },
    { "id": "site", "title": "Site",
      "properties": [ { "name": "name", "type": "text", "required": true },
                      { "name": "kind", "type": "text" } ] },
    { "id": "asset", "title": "Asset",
      "properties": [ { "name": "serial", "type": "text", "required": true },
                      { "name": "kind", "type": "text" },
                      { "name": "status", "type": "text" },
                      { "name": "hours", "type": "int" } ] }
  ],
  "linkTypes": [
    { "id": "unit_site", "name": "based at", "from": "unit", "to": "site",
      "cardinality": "many-to-many" },
    { "id": "asset_unit", "name": "assigned to", "from": "asset", "to": "unit",
      "cardinality": "many-to-many" }
  ],
  "actions": [
    { "id": "set_readiness", "name": "setReadiness", "title": "Set readiness",
      "objectType": "unit", "humanGated": true, "marking": "restricted",
      "purposes": ["operations"],
      "effect": { "kind": "cycle-property", "property": "readiness",
                  "values": ["green", "amber", "red"] } },
    { "id": "ground_asset", "name": "groundAsset", "title": "Declare unserviceable",
      "objectType": "asset", "humanGated": true, "marking": "restricted",
      "purposes": ["operations"],
      "effect": { "kind": "set-property", "property": "status", "value": "unserviceable" } }
  ]
}
