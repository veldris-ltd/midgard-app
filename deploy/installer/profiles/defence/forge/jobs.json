{
  "version": 1,
  "jobs": [
    { "id": "sites", "every": 600,
      "source": { "file": "sites.csv",
                  "columns": [ { "name": "key", "type": "text" },
                               { "name": "name", "type": "text" },
                               { "name": "kind", "type": "text" } ] },
      "objects": { "type": "site", "key": "key", "marking": "restricted",
                   "purposes": ["operations"],
                   "properties": { "name": "name", "kind": "kind" } } },
    { "id": "units", "every": 120,
      "source": { "file": "units.csv",
                  "columns": [ { "name": "designation", "type": "text" },
                               { "name": "echelon", "type": "text" },
                               { "name": "readiness", "type": "text" },
                               { "name": "site", "type": "text" } ] },
      "objects": { "type": "unit", "key": "designation", "marking": "restricted",
                   "purposes": ["operations"],
                   "properties": { "designation": "designation", "echelon": "echelon",
                                   "readiness": "readiness" } },
      "links": [ { "type": "unit_site", "from": "designation", "to": "site" } ] },
    { "id": "assets", "every": 60,
      "source": { "file": "assets.csv",
                  "columns": [ { "name": "serial", "type": "text" },
                               { "name": "kind", "type": "text" },
                               { "name": "status", "type": "text" },
                               { "name": "hours", "type": "int", "nullable": true },
                               { "name": "unit", "type": "text" } ] },
      "objects": { "type": "asset", "key": "serial", "marking": "restricted",
                   "purposes": ["operations"],
                   "properties": { "serial": "serial", "kind": "kind", "status": "status",
                                   "hours": "hours" } },
      "links": [ { "type": "asset_unit", "from": "serial", "to": "unit" } ] }
  ]
}
