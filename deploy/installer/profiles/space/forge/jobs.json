{
  "version": 1,
  "jobs": [
    { "id": "spacecraft", "every": 300,
      "source": { "file": "spacecraft.csv",
                  "columns": [ { "name": "designator", "type": "text" },
                               { "name": "orbit", "type": "text" },
                               { "name": "mode", "type": "text" } ] },
      "objects": { "type": "spacecraft", "key": "designator", "marking": "internal",
                   "purposes": ["operations", "mission-ops"],
                   "properties": { "designator": "designator", "orbit": "orbit",
                                   "mode": "mode" } } },
    { "id": "stations", "every": 600,
      "source": { "file": "stations.csv",
                  "columns": [ { "name": "key", "type": "text" },
                               { "name": "name", "type": "text" },
                               { "name": "band", "type": "text" } ] },
      "objects": { "type": "ground_station", "key": "key", "marking": "internal",
                   "purposes": ["operations", "mission-ops"],
                   "properties": { "name": "name", "band": "band" } } },
    { "id": "contacts", "every": 60,
      "source": { "file": "contacts.csv",
                  "columns": [ { "name": "reference", "type": "text" },
                               { "name": "aos", "type": "text" },
                               { "name": "los", "type": "text" },
                               { "name": "max_elevation_deg", "type": "float", "nullable": true },
                               { "name": "status", "type": "text" },
                               { "name": "spacecraft", "type": "text" },
                               { "name": "station", "type": "text" } ] },
      "objects": { "type": "contact", "key": "reference", "marking": "internal",
                   "purposes": ["operations", "mission-ops"],
                   "properties": { "reference": "reference", "aos": "aos", "los": "los",
                                   "max_elevation_deg": "max_elevation_deg",
                                   "status": "status" } },
      "links": [ { "type": "contact_spacecraft", "from": "reference", "to": "spacecraft" },
                 { "type": "contact_station", "from": "reference", "to": "station" } ] },
    { "id": "anomalies", "every": 60,
      "source": { "file": "anomalies.csv",
                  "columns": [ { "name": "reference", "type": "text" },
                               { "name": "subsystem", "type": "text" },
                               { "name": "severity", "type": "text" },
                               { "name": "status", "type": "text" },
                               { "name": "spacecraft", "type": "text" } ] },
      "objects": { "type": "anomaly", "key": "reference", "marking": "internal",
                   "purposes": ["operations", "mission-ops"],
                   "properties": { "reference": "reference", "subsystem": "subsystem",
                                   "severity": "severity", "status": "status" } },
      "links": [ { "type": "anomaly_spacecraft", "from": "reference", "to": "spacecraft" } ] }
  ]
}
