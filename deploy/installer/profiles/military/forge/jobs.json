            "nullable": true
          },
          {
            "name": "command",
            "type": "text",
            "nullable": true
          }
        ]
      },
      "objects": {
        "type": "formation",
        "key": "designation",
        "marking": "restricted",
        "purposes": [
          "operations"
        ],
        "properties": {
          "designation": "designation",
          "nation": "nation",
          "level": "level",
          "command": "command"
        }
      }
    },
