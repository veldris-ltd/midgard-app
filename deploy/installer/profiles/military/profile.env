# Military: aligned to British and EU practice, for exercises and training. Sourced by
# mg-install. [NFR-SEC-1] [NFR-PRV-1] [NFR-AVA-1]
PROFILE_TITLE="Military (British and EU aligned)"
PROFILE_SUMMARY="Formations, units, sites, assets, taskings and incidents, with readiness, serviceability and tasking as human-gated actions; recorded weather, earthquake and space weather data; Heimdall feeds for aviation, maritime, communications, hazards and news; the Bifrost fleet manager."
PROFILE_COMPONENTS="forge mimir bifrost heimdall"
PROFILE_MODEL=granite
PROFILE_TOTP=required
PROFILE_ADMINS=2
PROFILE_CLEARANCE=restricted
PROFILE_PURPOSES=operations
PROFILE_TIER=G
PROFILE_SAMPLES="weather,earthquakes,space_weather,aircraft"
PROFILE_FEEDS="aviation maritime communications hazards information"
PROFILE_NOTES=(
  "This build is not accredited. Do not process UK classified information above OFFICIAL, or NATO or EU classified information, on it."
  "Midgard's bands (open, internal, restricted, confidential) are not UK Government Security Classifications, NATO or EU markings. Any mapping between them is for your accreditor to set."
  "UK use follows JSP 440 and your accreditation authority; the security rules for EU classified information are in Council Decision 2013/488/EU."
  "Install on hardware you control, then disconnect it: Midgard needs no network once installed. Rented and cloud servers suit exercise and training data only."
  "The Heimdall feeds are open-source information: aviation notices, ship positions, internet measurements, fire hotspots and news. They are sample data for exercises, not an intelligence source."
  "Two administrators are created for dual control. Hand each passkey file to its owner and remove it from this server."
)
