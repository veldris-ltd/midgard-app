{
  "version": 1,
  "jobs": [
    { "id": "matters", "every": 300,
      "source": { "file": "matters.csv",
                  "columns": [ { "name": "reference", "type": "text" },
                               { "name": "title", "type": "text" },
                               { "name": "practice_area", "type": "text" },
                               { "name": "status", "type": "text" },
                               { "name": "hold", "type": "text" } ] },
      "objects": { "type": "matter", "key": "reference", "marking": "restricted",
                   "purposes": ["operations", "case-work"],
                   "properties": { "reference": "reference", "title": "title",
                                   "practice_area": "practice_area", "status": "status",
                                   "hold": "hold" } } },
    { "id": "parties", "every": 300,
      "source": { "file": "parties.csv",
                  "columns": [ { "name": "key", "type": "text" },
                               { "name": "name", "type": "text" },
                               { "name": "capacity", "type": "text" },
                               { "name": "matter", "type": "text" } ] },
      "objects": { "type": "party", "key": "key", "marking": "restricted",
                   "purposes": ["operations", "case-work"],
                   "properties": { "name": "name", "capacity": "capacity" } },
      "links": [ { "type": "party_matter", "from": "key", "to": "matter" } ] },
    { "id": "documents", "every": 120,
      "source": { "file": "documents.csv",
                  "columns": [ { "name": "reference", "type": "text" },
                               { "name": "title", "type": "text" },
                               { "name": "kind", "type": "text" },
                               { "name": "pages", "type": "int", "nullable": true },
                               { "name": "review", "type": "text" },
                               { "name": "matter", "type": "text" } ] },
      "objects": { "type": "document", "key": "reference", "marking": "restricted",
                   "purposes": ["operations", "case-work"],
                   "properties": { "reference": "reference", "title": "title",
                                   "kind": "kind", "pages": "pages", "review": "review" } },
      "links": [ { "type": "document_matter", "from": "reference", "to": "matter" } ] }
  ]
}
