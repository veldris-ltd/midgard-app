{
  "version": 1,
  "jobs": [
    { "id": "substations", "every": 600,
      "source": { "file": "substations.csv",
                  "columns": [ { "name": "key", "type": "text" },
                               { "name": "name", "type": "text" },
                               { "name": "voltage_kv", "type": "int" },
                               { "name": "status", "type": "text" } ] },
      "objects": { "type": "substation", "key": "key", "marking": "internal",
                   "purposes": ["operations", "asset-management"],
                   "properties": { "name": "name", "voltage_kv": "voltage_kv",
                                   "status": "status" } } },
    { "id": "feeders", "every": 300,
      "source": { "file": "feeders.csv",
                  "columns": [ { "name": "key", "type": "text" },
                               { "name": "name", "type": "text" },
                               { "name": "customers", "type": "int", "nullable": true },
                               { "name": "substation", "type": "text" } ] },
      "objects": { "type": "feeder", "key": "key", "marking": "internal",
                   "purposes": ["operations", "asset-management"],
                   "properties": { "name": "name", "customers": "customers" } },
      "links": [ { "type": "feeder_from", "from": "key", "to": "substation" } ] },
    { "id": "transformers", "every": 60,
      "source": { "file": "transformers.csv",
                  "columns": [ { "name": "serial", "type": "text" },
                               { "name": "rating_kva", "type": "int" },
                               { "name": "load_fraction", "type": "float", "nullable": true },
                               { "name": "oil_temp_c", "type": "float", "nullable": true },
                               { "name": "in_service", "type": "bool", "nullable": true },
                               { "name": "status", "type": "text" },
                               { "name": "feeder", "type": "text" } ] },
      "objects": { "type": "transformer", "key": "serial", "marking": "internal",
                   "purposes": ["operations", "asset-management"],
                   "properties": { "serial": "serial", "rating_kva": "rating_kva",
                                   "load_fraction": "load_fraction", "oil_temp_c": "oil_temp_c",
                                   "in_service": "in_service", "status": "status" } },
      "links": [ { "type": "transformer_on", "from": "serial", "to": "feeder" } ] }
  ]
}
