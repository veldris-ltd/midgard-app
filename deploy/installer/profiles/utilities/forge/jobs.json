      "id": "substations",
      "every": 600,
      "source": {
        "file": "substations.csv",
        "columns": [
          {
            "name": "key",
            "type": "text"
          },
          {
            "name": "name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "voltage_kv",
            "type": "int",
            "nullable": true
          },
          {
            "name": "status",
            "type": "text",
            "nullable": true
          },
          {
            "name": "region",
            "type": "text",
            "nullable": true
          }
        ]
      },
      "objects": {
        "type": "substation",
        "key": "key",
        "marking": "internal",
        "purposes": [
          "operations",
          "asset-management"
        ],
        "properties": {
          "name": "name",
          "voltage_kv": "voltage_kv",
          "status": "status"
        }
      },
      "links": [
        {
          "type": "substation_in",
          "from": "key",
          "to": "region"
        }
      ]
    },
