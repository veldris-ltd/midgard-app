# Utilities: electricity, water, transport and communications. Sourced by mg-install.
# [NFR-SEC-1] [NFR-PRV-1]
PROFILE_TITLE="Utilities (water, electricity, transport, communications)"
PROFILE_SUMMARY="Substations, feeders, transformers, water assets, telecommunications sites and transport assets, with inspection, isolation and status as actions; recorded GB grid, flood, TfL, weather and hazard data; Heimdall feeds for energy, water, transport, communications and hazards."
PROFILE_COMPONENTS="forge mimir heimdall"
PROFILE_MODEL=granite
PROFILE_TOTP=required
PROFILE_ADMINS=2
PROFILE_CLEARANCE=restricted
PROFILE_PURPOSES=operations,asset-management
PROFILE_TIER=M
PROFILE_SAMPLES="grid_frequency,grid_fuel,grid_intensity_linked,grid_intensity_other,floods,tfl,weather,earthquakes,space_weather,air_quality"
PROFILE_FEEDS="energy water transport communications hazards"
PROFILE_NOTES=(
  "The recorded datasets are real GB grid, flood, TfL, weather, earthquake and space weather data from October 2026; the asset records are fictional."
  "Isolating a substation or closing a road in Midgard records a decision. It does not operate plant and has no link to SCADA or other control systems."
  "Operators of essential services should consider the NIS Regulations 2018 and the NCSC Cyber Assessment Framework; in the EU, the NIS2 Directive (EU) 2022/2555 and the CER Directive (EU) 2022/2557."
  "Keep the server on a network segment separate from operational technology."
  "Two administrators are created for dual control. Hand each passkey file to its owner and remove it from this server."
)
