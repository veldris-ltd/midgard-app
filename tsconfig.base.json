{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@midgard/design-system": ["ui/design-system/src/index.ts"],
      "@midgard/design-system/*": ["ui/design-system/src/*"],
      "@midgard/sdk": ["sdk/ts/src/index.ts"],
      "@midgard/sdk/*": ["sdk/ts/src/*"],
      "@midgard/ui-shared": ["ui/shared/src/index.ts"],
      "@midgard/ui-shared/*": ["ui/shared/src/*"]
    }
  }
}
