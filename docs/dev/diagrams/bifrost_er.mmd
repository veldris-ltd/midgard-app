    RELEASE ||--o{ ROLLOUT : triggers
    ROLLOUT ||--o{ STAGE : has
    STAGE ||--o{ HEALTH_GATE : guarded_by
    ROLLOUT ||--o{ ROLLBACK : may_trigger
    ARTEFACT ||--|| SIGNATURE : signed_by
