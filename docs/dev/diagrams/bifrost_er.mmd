        uuid id PK
        string version
        uuid actor_id
        timestamp created_at
    }
    ARTEFACT {
        uuid id PK
        string digest
        string sig_alg
        bytea ml_dsa_sig
    }
    ROLLOUT {
        uuid id PK
        uuid release_id FK
        string strategy
        string status
    }
    STAGE {
        uuid id PK
        uuid rollout_id FK
        string env
        int order
    }