%%{init: {'theme':'neutral'}}%%
flowchart TB
    subgraph orion["Everything Orion does (Phases 1-3)"]
        sense["Sense / detect / track"]:::orion
        fuse["Fuse / federate / build 3D picture"]:::orion
        analyse["Analyse / rank / simulate"]:::orion
        present["Present options + evidence"]:::orion
    end
    gate{"HUMAN AUTHORISATION\n(mandatory, audited,\nno bypass in design)"}:::gate
